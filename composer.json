{
    "name": "ginger-tek/faktura",
    "description": "Simple, self-hosted, flat-file invoicing web app, with invoice templating and user access control",
    "type": "project",
    "license": "ISC",
    "require": {
        "ginger-tek/routy": "^4.4",
        "parsedown/parsedown": "^1.8",
        "firebase/php-jwt": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "cli": "php ./src/Cli.php",
        "setup": [
            "@cli setup-env",
            "@cli init-schema"
        ]
    }
}